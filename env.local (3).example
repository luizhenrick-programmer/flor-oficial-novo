# Copie este arquivo para .env.local (na raiz do projeto) e preencha.
# Depois de mudar o .env.local, pare o servidor e rode "npm run dev" de novo.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon). Se o painel mostrar a chave "publishable", use ela aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servidor (service_role). Se o painel mostrar a chave "secret", use ela aqui.
# NUNCA coloque o prefixo NEXT_PUBLIC_ nesta variável e nunca suba este arquivo para o Git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Formulário de contato (Resend) ---
RESEND_API_KEY=
# E-mail que RECEBE as mensagens (pode ser mais de um, separados por vírgula)
CONTACT_TO_EMAIL=
# Remetente. Precisa ser de um domínio verificado no Resend. Ex.: Flor Oficial <contato@seudominio.com.br>
CONTACT_FROM_EMAIL=

# --- WhatsApp da loja (só números, com país e DDD). Ex.: 5561999999999 ---
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Endereço público do site (sitemap e SEO). Ex.: https://www.floroficial.com.br ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

